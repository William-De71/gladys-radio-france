{
  "name": "gladys-radio-france",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial Gladys Assistant external integration for the Radio France Open API: show, segment and track on air of every Radio France station, scene triggers and actions, dashboard widgets, within the daily quota of the API. Not affiliated with Radio France.",
  "homepage": "https://github.com/William-De71/gladys-radio-france",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-radio-france.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "radio-france",
    "radio",
    "france-inter",
    "fip",
    "franceinfo",
    "home-automation"
  ]
}
